{
  "name": "claude-code-simple-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Simple backend for executing Claude Code tasks",
  "main": "server.ts",
  "scripts": {
    "start": "tsx server.ts",
    "dev": "tsx watch server.ts",
    "build": "tsc server.ts --outDir dist --module esnext --target es2022 --moduleResolution node --esModuleInterop",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.1.30",
    "@anthropic-ai/claude-code": "2.0.24",
    "@hono/node-server": "1.19.5",
    "hono": "4.10.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.9.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}

